{
  "name": "daily-devotional-shorts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/pipeline.js",
    "auth": "node scripts/auth_youtube.js",
    "auth:fresh": "node scripts/auth_youtube.js --fresh",
    "show:secrets": "node scripts/show_secrets.js",
    "dev": "remotion preview src/index.ts",
    "render": "remotion render src/index.ts DailyShort60 out/short-60s.mp4",
    "check": "node --check src/pipeline.js && npx tsc --noEmit",
    "test": "npx tsx --test tests/panchang_validation.test.ts && node --test tests/request-intake.test.js tests/youtube-analytics.test.js tests/youtube-publish-idempotency.test.js tests/render-qc.test.js tests/hindi-tts-voice.test.js tests/workflow-health.test.js tests/editorial-weekly-plan.test.js tests/social-source-verification.test.js",
    "analytics:report": "node src/youtube/analytics-report.js",
    "render:40": "remotion render src/index.ts DailyShort40 out/short-40s.mp4",
    "render:60": "remotion render src/index.ts DailyShort60 out/short-60s.mp4",
    "editorial:preview": "node scripts/preview-weekly-editorial-plan.js"
  },
  "dependencies": {
    "@google/genai": "^0.2.0",
    "@remotion/bundler": "^4.0.230",
    "@remotion/cli": "^4.0.230",
    "@remotion/google-fonts": "^4.0.541",
    "@remotion/noise": "^4.0.541",
    "@remotion/paths": "^4.0.541",
    "@remotion/renderer": "^4.0.230",
    "@remotion/shapes": "^4.0.541",
    "@remotion/transitions": "^4.0.541",
    "googleapis": "^144.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.230"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
